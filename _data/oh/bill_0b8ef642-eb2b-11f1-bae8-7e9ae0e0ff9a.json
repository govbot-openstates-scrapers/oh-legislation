{"legislative_session": "136", "identifier": "HB 417", "title": "Regards animal abuse offenses and penalties", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Agriculture", "Animals", "Crime and Punishment", "Crimes, Corrections, and Law Enforcement", "Local Government", "State and Local Government"], "abstracts": [{"note": "long title", "abstract": "To amend sections 109.803, 955.54, 955.99, 959.131, 959.99, 2921.321, and 2929.18 and to enact sections 955.55, 955.56, and 955.57 of the Revised Code to prohibit the abuse of a companion animal corpse, to prohibit an animal abuse offender from owning a dog in certain circumstances, and to establish mandatory fines for violations of an animal abuse offense."}], "other_titles": [{"note": "long title", "title": "To amend sections 109.803, 955.54, 955.99, 959.131, 959.99, 2921.321, and 2929.18 and to enact sections 955.55, 955.56, and 955.57 of the Revised Code to prohibit the abuse of a companion animal corpse, to prohibit an animal abuse offender from owning a dog in certain circumstances, and to establish mandatory fines for violations of an animal abuse offense."}, {"note": "long title", "title": "To amend sections 109.79, 955.54, 955.99, 959.131, 959.99, 2921.321, and 2929.18 and to enact sections 955.55, 955.56, and 955.57 of the Revised Code to prohibit the abuse of a companion animal corpse, to prohibit an animal abuse offender from owning a companion animal in certain circumstances, and to establish mandatory fines for violations of an animal abuse offense."}, {"note": "long title", "title": "To amend sections 109.79, 955.54, 955.99, 959.131, 959.99, 2921.321, and 2929.18 and to enact sections 955.55, 955.56, and 955.57 of the Revised Code to prohibit the abuse of a companion animal corpse, to prohibit an animal abuse offender from owning a companion animal in certain circumstances, and to establish mandatory fines for violations of an animal abuse offense."}], "ot